def main():
    setup_dpi()

    print("=" * 55)
    print("RAY-BAN META + YOLO26 + OPENAI LLM + VOICE")
    print("=" * 55)

    print("[SAFETY] Epson VT6 movement DISABLED")

    session, input_name, size = init_yolo()

    api_key = os.getenv("OPENAI_API_KEY")

    if api_key:
        client = OpenAI(api_key=api_key)
        print("[LLM] OpenAI client initialized.")
    else:
        client = None
        print("[LLM] OPENAI_API_KEY missing.")

    print("[MIC] Backend:", AUDIO_BACKEND)

    print("""
KEYBOARD CONTROLS

S = Describe scene
T = Type a question
V = Ask with microphone
M = Select microphone
A = Toggle automatic narration
B = Test repeated speech
K = Assess knife risk (snapshot + 30s near-knife human traffic)
Q = Quit
""")

    automatic = False
    traffic_monitor = HumanTrafficMonitor()
    last_auto = time.monotonic()
    last_log = 0
    last_risk_result = None

    window_name = "Ray-Ban YOLO + OpenAI + Voice"

    with mss.mss() as sct:
        region = select_capture_region(sct)

        print("[CAPTURE]", region)

        cv2.namedWindow(
            window_name,
            cv2.WINDOW_NORMAL
        )

        try:
            while True:
                screenshot = np.asarray(
                    sct.grab(region)
                )

                frame = cv2.cvtColor(
                    screenshot,
                    cv2.COLOR_BGRA2BGR
                )

                try:
                    detections, annotated = yolo_detect(
                        frame,
                        session,
                        input_name,
                        size
                    )
                except Exception as e:
                    print("[YOLO ERROR]", e)
                    break

                cv2.putText(
                    annotated,
                    "S:Scene T:Type V:Voice M:Mic "
                    "A:Auto B:Test K:Risk Q:Quit",
                    (10, 25),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (0, 255, 255),
                    2
                )

                if automatic:
                    cv2.putText(
                        annotated,
                        "AUTO ON",
                        (10, 55),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.7,
                        (0, 255, 255),
                        2
                    )

                traffic_monitor.update(detections, frame.shape)
                traffic_data = traffic_monitor.snapshot()
                cv2.putText(
                    annotated,
                    f"Near-knife tracks (30s): {traffic_data['unique_near_knife_tracks']} "
                    f"({'ready' if traffic_data['human_traffic'] is not None else 'collecting'})",
                    (10, min(140, annotated.shape[0] - 10)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.48, (0, 255, 255), 1
                )
                draw_risk_overlay(annotated, last_risk_result)

                h, w = annotated.shape[:2]

                scale = min(
                    1.0,
                    1100 / w,
                    750 / h
                )

                if scale < 1:
                    preview = cv2.resize(
                        annotated,
                        None,
                        fx=scale,
                        fy=scale
                    )
                else:
                    preview = annotated

                cv2.imshow(
                    window_name,
                    preview
                )

                now = time.monotonic()

                if now - last_log >= 5:
                    counts = Counter(
                        d["label"] for d in detections
                    )

                    print(
                        "[YOLO]",
                        dict(counts)
                        if counts
                        else "No objects detected"
                    )

                    last_log = now

                pressed = cv2.waitKey(1) & 0xFF

                question = None

                if pressed in (ord("q"), 27):
                    break

                elif pressed == ord("b"):
                    speak(
                        "Hello. This is a speech test. "
                        "I can speak every time "
                        "you press the B key."
                    )

                elif pressed == ord("k"):
                    fresh = np.asarray(sct.grab(region))
                    risk_frame = cv2.cvtColor(fresh, cv2.COLOR_BGRA2BGR)
                    risk_detections, _ = yolo_detect(
                        risk_frame, session, input_name, size
                    )
                    traffic_monitor.update(risk_detections, risk_frame.shape)
                    traffic_snapshot = traffic_monitor.snapshot()
                    if not any(d["label"] == "knife" for d in risk_detections):
                        last_risk_result = calculate_knife_risk(
                            risk_detections, risk_frame.shape, None, traffic_snapshot
                        )
                    else:
                        risk_context = (
                            classify_context(client, risk_frame, risk_detections)
                            if client is not None else None
                        )
                        last_risk_result = calculate_knife_risk(
                            risk_detections, risk_frame.shape, risk_context, traffic_snapshot
                        )
                    print("[RISK]", json.dumps(last_risk_result, indent=2))
                    risk_message = describe_knife_danger(last_risk_result)
                    print("[KNIFE DANGER]", risk_message, flush=True)
                    log_knife_risk(last_risk_result)
                    speak(risk_message)

                elif pressed == ord("s"):
                    question = (
                        "What objects do you see, "
                        "and where are they?"
                    )

                elif pressed == ord("t"):
                    question = input(
                        "\nYour question: "
                    ).strip()

                elif pressed == ord("v"):
                    question = listen_question()

                elif pressed == ord("m"):
                    select_microphone()

                elif pressed == ord("a"):
                    automatic = not automatic

                    last_auto = time.monotonic()

                    print(
                        "[AUTO]",
                        "ON" if automatic else "OFF"
                    )

                if (
                    automatic
                    and time.monotonic() - last_auto
                    >= AUTO_INTERVAL_SECONDS
                ):
                    if not question:
                        question = (
                            "Describe the current "
                            "scene briefly."
                        )

                    last_auto = time.monotonic()

                if question:
                    if client is None:
                        print(
                            "[LLM] Configure "
                            "OPENAI_API_KEY first."
                        )
                    else:
                        # Capture a fresh frame after
                        # listening or typing.
                        fresh = np.asarray(
                            sct.grab(region)
                        )

                        latest_frame = cv2.cvtColor(
                            fresh,
                            cv2.COLOR_BGRA2BGR
                        )

                        latest_detections, _ = yolo_detect(
                            latest_frame,
                            session,
                            input_name,
                            size
                        )

                        answer = ask_llm(
                            client,
                            latest_frame,
                            latest_detections,
                            question
                        )

                        if answer:
                            print(
                                "[VOICE] Sending AI "
                                "answer to speaker..."
                            )

                            speak(answer)

        finally:
            cv2.destroyAllWindows()

    print("[INFO] Program stopped.")
    print("[SAFETY] No robot movement was executed.")


if __name__ == "__main__":
    main()
