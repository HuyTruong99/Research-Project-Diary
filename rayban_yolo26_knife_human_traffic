def init_yolo():
    if not MODEL_PATH.is_file():
        raise FileNotFoundError(
            f"Missing YOLO model: {MODEL_PATH}\n"
            "Put yolo26n.onnx beside your Python file."
        )

    print("[YOLO] Loading model...")

    session = ort.InferenceSession(
        str(MODEL_PATH),
        providers=["CPUExecutionProvider"]
    )

    inp = session.get_inputs()[0]

    if inp.type != "tensor(float)":
        raise ValueError(
            f"Unsupported model input type: {inp.type}"
        )

    shape = inp.shape

    height = (
        shape[2]
        if isinstance(shape[2], int)
        else IMAGE_SIZE
    )

    width = (
        shape[3]
        if isinstance(shape[3], int)
        else IMAGE_SIZE
    )

    if height <= 0 or width <= 0:
        raise ValueError("Invalid YOLO model input size.")

    print("[YOLO] Model loaded.")
    print("[YOLO] Input:", shape)
    print(
        "[YOLO] Output:",
        [(o.name, o.shape) for o in session.get_outputs()]
    )

    return session, inp.name, (width, height)

# ---------------------------------------------------
# LETTERBOX PREPROCESSING
# ---------------------------------------------------

def letterbox(image, size):
    target_w, target_h = size

    h, w = image.shape[:2]

    scale = min(
        target_w / w,
        target_h / h
    )

    new_w = max(1, round(w * scale))
    new_h = max(1, round(h * scale))

    resized = cv2.resize(
        image,
        (new_w, new_h)
    )

    dx = (target_w - new_w) // 2
    dy = (target_h - new_h) // 2

    canvas = np.full(
        (target_h, target_w, 3),
        114,
        dtype=np.uint8
    )

    canvas[
        dy:dy + new_h,
        dx:dx + new_w
    ] = resized

    return canvas, scale, dx, dy

