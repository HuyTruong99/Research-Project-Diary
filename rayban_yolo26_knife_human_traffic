# YOLO DETECTION
# ---------------------------------------------------

def yolo_detect(frame, session, input_name, size):
    """Detect COCO objects using YOLO26 ONNX.

    Supports either:
      * YOLO26 end-to-end/NMS-free (N, 300, 6), xyxy + confidence + class
      * Standard raw predictions (N, 84, 8400), xywh + class probabilities
    Also accepts legacy 85-column YOLO outputs with objectness.
    """
    padded, scale, dx, dy = letterbox(frame, size)
    rgb = cv2.cvtColor(padded, cv2.COLOR_BGR2RGB)
    blob = np.ascontiguousarray(
        rgb.transpose(2, 0, 1)[None], dtype=np.float32
    ) / 255.0

    raw = session.run(None, {input_name: blob})[0]
    output = np.squeeze(raw)
    if output.ndim != 2:
        raise ValueError(f"Unsupported YOLO26 output shape: {raw.shape}")

    # Normalize channel-first matrices to (detections, features).
    if output.shape[0] in (6, 84, 85) and output.shape[1] > output.shape[0]:
        output = output.T

    if output.shape[1] == 6:
        # End-to-end NMS-free output (or embedded NMS): xyxy, score, class_id.
        # No external NMS: coordinates are already the final detection boxes.
        xyxy = output[:, :4].astype(np.float32)
        scores = output[:, 4].astype(np.float32)
        class_ids = np.rint(output[:, 5]).astype(np.int32)
        use_nms = False
    elif output.shape[1] in (84, 85):
        # Traditional raw output: center-x, center-y, width, height, class scores.
        if output.shape[1] == 84:
            class_scores = output[:, 4:]
            class_ids = np.argmax(class_scores, axis=1)
            scores = class_scores[np.arange(len(output)), class_ids]
        else:
            class_scores = output[:, 5:]
            class_ids = np.argmax(class_scores, axis=1)
            scores = (output[:, 4] *
                      class_scores[np.arange(len(output)), class_ids])
        cx, cy, bw, bh = output[:, :4].T
        xyxy = np.column_stack((cx - bw / 2, cy - bh / 2,
                                cx + bw / 2, cy + bh / 2))
        use_nms = True
    else:
        raise ValueError(
            f"Unsupported YOLO26 output: {raw.shape}; "
            "expected (..., 6), (..., 84), or (..., 85)"
        )

    valid = (np.isfinite(scores) & np.isfinite(xyxy).all(axis=1) &
             (scores >= CONFIDENCE) &
             (class_ids >= 0) & (class_ids < len(COCO)))
    xyxy, scores, class_ids = xyxy[valid], scores[valid], class_ids[valid]

    img_h, img_w = frame.shape[:2]
    boxes, classes, confidences = [], [], []
    for (x1, y1, x2, y2), score, cls in zip(xyxy, scores, class_ids):
        x1 = int(np.clip((x1 - dx) / scale, 0, img_w - 1))
        y1 = int(np.clip((y1 - dy) / scale, 0, img_h - 1))
        x2 = int(np.clip((x2 - dx) / scale, 0, img_w - 1))
        y2 = int(np.clip((y2 - dy) / scale, 0, img_h - 1))
        if x2 <= x1 or y2 <= y1:
            continue
        boxes.append([x1, y1, x2 - x1, y2 - y1])
        classes.append(int(cls))
        confidences.append(float(score))

    if use_nms:
        selected = []
        for cls in sorted(set(classes)):
            ids = [i for i, c in enumerate(classes) if c == cls]
            kept = cv2.dnn.NMSBoxes(
                [boxes[i] for i in ids],
                [confidences[i] for i in ids],
                CONFIDENCE,
                IOU_THRESHOLD,
            )
            if len(kept):
                selected.extend(ids[int(j)] for j in np.asarray(kept).reshape(-1))
    else:
        selected = list(range(len(boxes)))

    selected.sort(key=lambda i: confidences[i], reverse=True)
    selected = selected[:MAX_DETECTIONS]

    annotated = frame.copy()
    detections = []
    for i in selected:
        x, y, w, h = boxes[i]
        label = COCO[classes[i]]
        confidence = confidences[i]
        detections.append({
            "label": label,
            "confidence": round(confidence, 2),
            "box": [x, y, w, h],
        })
        cv2.rectangle(annotated, (x, y), (x+w, y+h), (0, 200, 0), 2)
        cv2.putText(annotated, f"{label} {confidence:.2f}",
                    (x, max(20, y - 7)), cv2.FONT_HERSHEY_SIMPLEX,
                    0.6, (0, 240, 0), 2)

    return detections, annotated

