def clamp01(value):
    return max(0.0, min(1.0, float(value)))


def center_of(box):
    x, y, w, h = box
    return (x + w / 2, y + h / 2)


def image_proximity_proxy(knife, people, frame_shape):
    """Image-space proximity ONLY. Not physical distance."""
    if not people:
        return None
    height, width = frame_shape[:2]
    diagonal = math.hypot(width, height)
    distances = [
        math.dist(center_of(knife["box"]), center_of(p["box"]))
        / max(diagonal, 1)
        for p in people
    ]
    # Research heuristic: normalized image separation
    return round(clamp01(1.0 - min(distances) / 0.45), 3)


def classify_context(client, frame, detections):
    """LLM describes visible context, NOT the final risk score."""
    ok, jpg = cv2.imencode(
        ".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, JPEG_QUALITY]
    )
    if not ok:
        return None
    encoded = base64.b64encode(jpg.tobytes()).decode("ascii")
    summary = [
        {"label": d["label"], "confidence": d["confidence"],
         "box_xywh": d["box"]}
        for d in detections
    ]
    try:
        response = client.chat.completions.create(
            model=LLM_MODEL,
            temperature=0,
            response_format={"type": "json_object"},
            messages=[
                {"role": "system", "content": (
                    "Analyze ONE camera snapshot for research. Return ONLY "
                    "JSON with fields: environment (kitchen, hallway, "
                    "workspace, other, unknown), knife_surface (floor, "
                    "counter, table, held, other, unknown), "
                    "walkway (yes, no, unknown), "
                    "accessibility (low, medium, high, unknown), "
                    "explanation (short string). "
                    "Use unknown when visual evidence is insufficient. "
                    "Do not infer unseen people, motion, physical distance "
                    "or future events. Do not give a numerical risk score."
                )},
                {"role": "user", "content": [
                    {"type": "text", "text": (
                        "YOLO detections (image pixel boxes): "
                        + json.dumps(summary)
                    )},
                    {"type": "image_url", "image_url": {
                        "url": "data:image/jpeg;base64," + encoded,
                        "detail": "low"
                    }}
                ]}
            ],
            max_tokens=250
        )
        data = json.loads(response.choices[0].message.content or "{}")
        if not isinstance(data, dict):
            return None
        allowed = {
            "environment": {"kitchen", "hallway", "workspace", "other", "unknown"},
            "knife_surface": {"floor", "counter", "table", "held", "other", "unknown"},
            "walkway": {"yes", "no", "unknown"},
            "accessibility": {"low", "medium", "high", "unknown"}
        }
        for key, choices in allowed.items():
            value = str(data.get(key, "unknown")).lower().strip()
            data[key] = value if value in choices else "unknown"
        data["explanation"] = str(data.get("explanation", ""))[:350]
        return data
    except Exception as exc:
        print("[RISK] Context analysis unavailable:", exc)
        return None


class HumanTrafficMonitor:
    """Experimental near-knife person counter for a mostly stationary camera.

    Uses simple centroid matching, NOT a production-grade object tracker.
    Camera movement, occlusions, and ID switches can change the count.
    """

    def __init__(self):
        self.tracks = {}  # track ID -> (center, last_seen)
        self.next_id = 1
        self.near_events = {}  # track ID -> most recent time near a visible knife
        self.knife_frames = deque()  # timestamps when a knife was detected

    def update(self, detections, frame_shape, now=None):
        now = time.monotonic() if now is None else now
        fh, fw = frame_shape[:2]
        diag = max(1.0, math.hypot(fw, fh))
        people = [d for d in detections if d["label"] == "person"]
        knives = [d for d in detections if d["label"] == "knife"]

        # Expire old tracks and old rolling-window evidence.
        self.tracks = {
            tid: (pt, last) for tid, (pt, last) in self.tracks.items()
            if now - last <= TRACK_MAX_AGE_SECONDS
        }
        while self.knife_frames and now - self.knife_frames[0] > TRAFFIC_WINDOW_SECONDS:
            self.knife_frames.popleft()
        self.near_events = {
            tid: t for tid, t in self.near_events.items()
            if now - t <= TRAFFIC_WINDOW_SECONDS
        }
        if knives:
            self.knife_frames.append(now)

        # Greedy one-to-one matching. Works best with a steady camera.
        pairs = []
        for person_index, person in enumerate(people):
            pt = center_of(person["box"])
            for tid, (previous_pt, _) in self.tracks.items():
                distance = math.dist(pt, previous_pt) / diag
                if distance <= TRACK_MATCH_MAX_DIAGONAL:
                    pairs.append((distance, person_index, tid))
        used_people, used_tracks = set(), set()
        matches = {}
        for _, pi, tid in sorted(pairs):
            if pi not in used_people and tid not in used_tracks:
                matches[pi] = tid
                used_people.add(pi)
                used_tracks.add(tid)
        for pi, person in enumerate(people):
            tid = matches.get(pi)
            if tid is None:
                tid = self.next_id
                self.next_id += 1
            self.tracks[tid] = (center_of(person["box"]), now)
            # Use bottom-center as approximate ground contact point.
            x, y, w, h = person["box"]
            feet = (x + w / 2, y + h)
            if knives and any(
                math.dist(feet, center_of(knife["box"])) / diag
                <= PERSON_KNIFE_NEAR_DIAGONAL for knife in knives
            ):
                self.near_events[tid] = now

    def snapshot(self, now=None):
        now = time.monotonic() if now is None else now
        self.near_events = {
            tid: t for tid, t in self.near_events.items()
            if now - t <= TRAFFIC_WINDOW_SECONDS
        }
        while self.knife_frames and now - self.knife_frames[0] > TRAFFIC_WINDOW_SECONDS:
            self.knife_frames.popleft()
        count = len(self.near_events)
        # Not enough observed knife frames: lack of traffic != zero traffic.
        valid = len(self.knife_frames) >= MIN_KNIFE_FRAMES
        return {
            "window_seconds": TRAFFIC_WINDOW_SECONDS,
            "unique_near_knife_tracks": count,
            "knife_frames_observed": len(self.knife_frames),
            "human_traffic": round(min(1.0, count / TRAFFIC_SATURATION_PEOPLE), 3) if valid else None,
            "method": "approximate image-space track IDs near visible knife; not confirmed passersby",
            "camera_motion_warning": "Moving glasses, occlusion or ID switches can cause missed/double counts."
        }


def calculate_knife_risk(detections, frame_shape, context, traffic=None):
    """Unvalidated relative hazard-priority index, not injury likelihood."""
    knives = [d for d in detections if d["label"] == "knife"]
    people = [d for d in detections if d["label"] == "person"]
    if not knives:
        return {
            "status": "NO_KNIFE_DETECTED", "risk_score": None,
            "risk_level": "UNKNOWN", "human_traffic_observation": traffic,
            "reason": "YOLO did not detect a knife in this snapshot; this does not prove safety."
        }
    if context is None:
        return {
            "status": "INSUFFICIENT_CONTEXT", "risk_score": None,
            "risk_level": "UNKNOWN", "human_traffic_observation": traffic,
            "reason": "Context assessment unavailable."
        }

    walkway = context["walkway"]
    surface = context["knife_surface"]
    accessibility = context["accessibility"]
    environment = context["environment"]
    exposure = {"yes": 0.90, "no": 0.15}.get(walkway)
    access = {"high": 0.90, "medium": 0.50, "low": 0.10}.get(accessibility)
    context_value = {
        "hallway": 0.80, "kitchen": 0.25,
        "workspace": 0.40, "other": 0.50
    }.get(environment)
    if surface == "floor" and access is not None:
        access = max(access, 0.70)
    # One snapshot cannot determine knife motion. Never substitute zero.
    motion = None
    human_traffic = (traffic or {}).get("human_traffic")

    results = []
    for knife in knives:
        proximity = image_proximity_proxy(knife, people, frame_shape)
        factors = {
            "proximity": proximity, "exposure": exposure,
            "accessibility": access, "motion": motion,
            "context": context_value, "human_traffic": human_traffic
        }
        known = {k: v for k, v in factors.items() if v is not None}
        missing = [k for k, v in factors.items() if v is None]
        observed_weight = sum(RISK_WEIGHTS[k] for k in known)
        weighted_sum = sum(RISK_WEIGHTS[k] * v for k, v in known.items())
        observed_index = 100 * weighted_sum / observed_weight if observed_weight else None
        lower = 100 * weighted_sum
        upper = lower + 100 * sum(RISK_WEIGHTS[k] for k in missing)

        def band(score):
            return "HIGH" if score >= 70 else "MODERATE" if score >= 35 else "LOW"

        preliminary_level = band(observed_index) if observed_index is not None else "UNKNOWN"
        interval_level = band(lower) if band(lower) == band(upper) else "UNKNOWN"
        results.append({
            "knife_box": knife["box"], "knife_confidence": knife["confidence"],
            "factors": factors, "missing_factors": missing,
            "observed_factor_index": round(observed_index, 1) if observed_index is not None else None,
            "observed_weight_fraction": round(observed_weight, 2),
            "risk_interval": [round(lower, 1), round(upper, 1)],
            "preliminary_risk_level": preliminary_level,
            "risk_level": interval_level
        })

    def aggregate(field):
        levels = [r[field] for r in results]
        return ("HIGH" if "HIGH" in levels else
                "UNKNOWN" if "UNKNOWN" in levels else
                "MODERATE" if "MODERATE" in levels else "LOW")

    return {
        "status": "EXPERIMENTAL_ESTIMATE", "risk_score": None,
        "risk_level": aggregate("risk_level"),
        "preliminary_risk_level": aggregate("preliminary_risk_level"),
        "person_count_detected": len(people),
        "human_traffic_observation": traffic,
        "context": context, "knives": results,
        "reason": "Unvalidated relative hazard-priority index, not injury probability or safety certification."
    }


def log_knife_risk(result):
    record = {"timestamp_utc": datetime.now(timezone.utc).isoformat(),
              "assessment": result}
    with RISK_LOG.open("a", encoding="utf-8") as file:
        file.write(json.dumps(record, ensure_ascii=False) + "\n")
    print("[RISK] Saved:", RISK_LOG)


def describe_knife_danger(result):
    """Explain visible danger without pretending a snapshot proves safety."""
    status = result.get("status")
    if status == "NO_KNIFE_DETECTED":
        return ("Knife danger cannot be assessed: the detector did not recognize "
                "a knife in this frame. This does not mean the scene is safe.")
    if status == "INSUFFICIENT_CONTEXT":
        return ("A knife was detected, but scene context could not be analyzed. "
                "Danger is unknown. Check your OpenAI API key and connectivity.")

    context = result.get("context") or {}
    knives = result.get("knives") or []
    level = result.get("risk_level", "UNKNOWN")
    preliminary = result.get("preliminary_risk_level", "UNKNOWN")
    traffic = result.get("human_traffic_observation") or {}
    details = []
    surface = context.get("knife_surface", "unknown")
    walkway = context.get("walkway", "unknown")
    access = context.get("accessibility", "unknown")
    people = result.get("person_count_detected", 0)

    if surface == "floor":
        details.append("the knife appears to be on the floor")
    elif surface == "held":
        details.append("the knife appears to be held")
    elif surface in ("table", "counter"):
        details.append(f"the knife appears to be on a {surface}")
    if walkway == "yes":
        details.append("it appears to be in a walkway")
    if access in ("low", "medium", "high"):
        details.append(f"accessibility appears {access}")
    if people:
        details.append(f"{people} person detection(s) appear in the frame")
    if traffic.get("human_traffic") is not None:
        details.append(f"approximately {traffic['unique_near_knife_tracks']} unique person track(s) near the knife in the last 30 seconds")
    else:
        details.append("human-traffic estimate unavailable: insufficient knife observations")

    evidence = "; ".join(details) if details else "visual context is limited"
    if knives:
        ranges = [r.get("risk_interval") for r in knives]
        ranges = [r for r in ranges if r and len(r) == 2]
        interval_text = (f" Prototype index range: {min(r[0] for r in ranges):.0f}"
                         f" to {max(r[1] for r in ranges):.0f} out of 100."
                         if ranges else "")
    else:
        interval_text = ""
    return (f"Experimental knife danger classification: {level}. "
            f"Preliminary observed-factor level: {preliminary}. "
            f"Visible evidence: {evidence}."
            f"{interval_text} Motion, real-world distance, and blade sharpness "
            "cannot be established from one camera image. "
            "This is not a safety clearance.")


def draw_risk_overlay(frame, result):
    if result is None:
        return
    level = result.get("risk_level", "UNKNOWN")
    color = {"LOW": (0, 180, 0), "MODERATE": (0, 180, 255),
             "HIGH": (0, 0, 255)}.get(level, (180, 180, 180))
    cv2.rectangle(frame, (8, 65), (min(frame.shape[1] - 1, 440), 105),
                  (25, 25, 25), -1)
    cv2.putText(frame, "KNIFE RISK: " + level + " (experimental)",
                (14, 91), cv2.FONT_HERSHEY_SIMPLEX, 0.55, color, 2)

# ---------------------------------------------------
# SCREEN CAPTURE REGION
# ---------------------------------------------------

def select_capture_region(sct):
    monitors = sct.monitors[1:]

    print("\nAVAILABLE MONITORS")

    for i, monitor in enumerate(monitors, 1):
        print(i, monitor)

    choice = input(
        "Monitor containing Ray-Ban video [1]: "
    ).strip()

    index = int(choice) if choice else 1

    if not 1 <= index <= len(monitors):
        raise ValueError("Invalid monitor number.")

    monitor = monitors[index - 1]

    screenshot = np.asarray(
        sct.grab(monitor)
    )

    screen = cv2.cvtColor(
        screenshot,
        cv2.COLOR_BGRA2BGR
    )

    window_name = "SELECT RAY-BAN VIDEO REGION"

    x, y, w, h = cv2.selectROI(
        window_name,
        screen,
        showCrosshair=True,
        fromCenter=False
    )

    cv2.destroyWindow(window_name)

    if w < 2 or h < 2:
        raise RuntimeError(
            "No capture region selected."
        )

    return {
        "left": monitor["left"] + int(x),
        "top": monitor["top"] + int(y),
        "width": int(w),
        "height": int(h)
    }

